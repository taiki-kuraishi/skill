{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboardApproval"],
  "timezone": "Asia/Tokyo",
  "platformAutomerge": false,
  "ignoreTests": false,
  "reviewers": ["taiki-kuraishi"],
  "assignAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Dashboard承認後のminor・digest更新は全CI成功後に自動マージする",
      "matchUpdateTypes": ["minor", "digest"],
      "automerge": true
    },
    {
      "description": "通常patchは作らない。vulnerabilityAlertsで再有効化されたsecurity patchは自動マージする",
      "matchUpdateTypes": ["patch"],
      "enabled": false,
      "automerge": true
    },
    {
      "description": "majorはsecurity修正でも手動マージにする",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "\"npm:(?<depName>@dprint/[^@\"]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>g-plane/pretty_yaml)-v(?<currentValue>[0-9.]+)\\.wasm"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
