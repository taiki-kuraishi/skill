{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 1"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 1,
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "major以外は全CI成功後に自動マージする。patchはvulnerabilityAlertsで再有効化されたsecurity patchのために含める。ブランチは月曜だけ作る（top-levelのschedule）",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "majorは壊れうるので手動マージにし、Dependency Dashboardで承認したものだけPRにする。開いたmajorが1つしかないPR枠を塞ぐのを防ぐ",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "通常patchは作らない。security patchはvulnerabilityAlerts.enabled=trueがalert由来の更新を再有効化するので出る",
      "matchUpdateTypes": ["patch"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "\"npm:(?<depName>@dprint/[^@\"]+)@(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dprint\\.json$/"],
      "matchStrings": [
        "https://plugins\\.dprint\\.dev/(?<depName>g-plane/pretty_yaml)-v(?<currentValue>[0-9.]+)\\.wasm"
      ],
      "datasourceTemplate": "github-releases"
    }
  ]
}
