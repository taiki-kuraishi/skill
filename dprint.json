{
  "includes": [
    "**/*.{md,toml,json,jsonc,yml,yaml}",
    ".github/**/*.{yml,yaml}",
    ".omp/skills/**/*.md",
    ".pi/skills/**/*.md"
  ],
  "excludes": [
    "mise.lock"
  ],
  "markdown": {
    "textWrap": "maintain"
  },
  "plugins": [
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/json@0.25.2",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm"
  ]
}
